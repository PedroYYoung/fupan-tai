# ===== 前端（Vite 环境变量，改完需重新 npm run build）=====
# 前端口令的 SHA-256（64位十六进制）。留空 = 关闭口令。
# 生成方式（浏览器控制台或 node）：
#   await crypto.subtle.digest('SHA-256', new TextEncoder().encode('你的口令'))
#   → [...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,'0')).join('')
VITE_GATE_HASH=

# ===== 数据脚本（build.py 使用）=====
# Tushare token，仅用于个股日线交叉校验（123积分仅够非复权日线），可留空
TUSHARE_TOKEN=

# PushPlus 推送 token（构建失败时通知，可留空关闭）
PUSHPLUS_TOKEN=

# Server酱 SendKey（备用通知渠道，可留空）
SC_SENDKEY=
